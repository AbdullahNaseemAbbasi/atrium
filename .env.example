# Copy to .env.local and fill in. Never commit real secrets.

# Signs the demo session cookie (HMAC-SHA256). Use 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Signs short-lived file download links. Falls back to SESSION_SECRET when empty.
STORAGE_SIGNING_SECRET=

# Shared secret for the billing webhook endpoint (/api/webhooks/billing).
# In production this is the Stripe webhook signing secret (whsec_...), test mode only.
BILLING_WEBHOOK_SECRET=

# Set to "true" on a public demo deployment so the app can boot without
# production secrets. Never set this on a real deployment.
ATRIUM_DEMO=false

# --- Added in the Supabase phase (not used yet) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server only, never exposed to the browser
# STRIPE_SECRET_KEY=sk_test_...     # test mode only
# STRIPE_PRICE_PROFESSIONAL_MONTH=
# STRIPE_PRICE_PROFESSIONAL_YEAR=
# STRIPE_PRICE_AGENCY_MONTH=
# STRIPE_PRICE_AGENCY_YEAR=
