# Copy to .env.local and fill in. Never commit real secrets.

# Signs the demo session cookie (HMAC-SHA256). Use 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Signs short-lived download links and upload tickets. Falls back to SESSION_SECRET when empty.
STORAGE_SIGNING_SECRET=

# Shared secret for the billing webhook endpoint (/api/webhooks/billing).
# In production this is the Stripe webhook signing secret (whsec_...), test mode only.
BILLING_WEBHOOK_SECRET=

# Set to "true" on a public demo deployment so the app can boot without
# production secrets. Never set this on a real deployment.
ATRIUM_DEMO=false

# --- Supabase (see docs/supabase.md) ---
# With all three set, the app runs on Supabase (Postgres, Auth, Storage, Realtime).
# Leave them empty to run the in-memory demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security: never expose it to the browser or commit it.
SUPABASE_SECRET_KEY=

# "memory" forces the in-memory backend even when Supabase keys are set
# (the E2E tests do this so they never touch the shared demo data).
ATRIUM_BACKEND=

# Bearer token for the scheduled demo reset (GET /api/cron/reset-demo).
CRON_SECRET=

# --- AI drafts (see docs/ai.md) ---
# Server only. With neither key, the AI buttons are hidden.
# Gemini has a free tier: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: the first Gemini model to try (default gemini-3.6-flash).
GEMINI_MODEL=
# Claude is used instead of Gemini when this is set: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- Stripe, test mode only (see docs/stripe.md) ---
# Sandbox secret key (sk_test_...). With it, plan changes run through Stripe; without it the
# simulated checkout runs. Then run: pnpm stripe:setup
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (or of `stripe listen` locally): whsec_...
STRIPE_WEBHOOK_SECRET=
